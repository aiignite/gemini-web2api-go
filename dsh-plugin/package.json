{
  "name": "dsh-gemini-web2api",
  "version": "1.0.0",
  "type": "module",
  "description": "DeepSeek Harness plugin: Gemini web (gemini.google.com) as a native provider through a local gemini-web2api-go OpenAI-compatible endpoint",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "gemini",
    "gemini-web2api",
    "openai-compatible",
    "llm-adapter"
  ],
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
